# Release settings, shared by the Makefile (include) and scripts/lib.sh.
# Format: KEY=VALUE, one per line. No quotes, no $ expansion, no comment
# after a value. Spaces inside a value are fine.

# Display name, used in release titles.
NAME=ccctl
# Binary name; also the Homebrew formula name.
BINARY=ccctl
# GitHub repo of the project.
REPO=crux/ccctl
# One-line description for the formula (at most 80 characters).
DESC=Inspect and manage Claude Code sessions and project folders
# SPDX licence identifier.
LICENSE=MIT
# Tag prefix (monorepos only).
TAG_PREFIX=
# Branch that releases are cut from.
RELEASE_BRANCH=main

# Main package and release platforms (os/arch, comma separated).
MAIN=./cmd/ccctl
PLATFORMS=darwin/arm64,darwin/amd64,linux/arm64,linux/amd64

# Homebrew tap; ccctl is a CLI, so a formula.
# COMPLETION: ccctl uses cobra, so the formula generates completions.
TAP_REPO=crux/homebrew-tap
TAP_KIND=Formula
COMPLETION=cobra
